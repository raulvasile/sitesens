{
  "collectionName": "components_blocks_calendar_customs",
  "info": {
    "displayName": "Calendar personalizat",
    "icon": "calendar",
    "description": "Calendar manual: editorul adaugă fiecare intrare direct în CMS (fără legătură cu colecția Evenimente). Util pentru deadlines, lansări, ședințe interne. Aceeași vizualizare lună/listă ca la Calendar evenimente."
  },
  "attributes": {
    "anchor_id": {
      "type": "string",
      "maxLength": 60
    },
    "kicker": {
      "type": "string",
      "maxLength": 80
    },
    "heading": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "subheading": {
      "type": "text",
      "maxLength": 400
    },
    "entries": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.calendar-entry"
    },
    "default_view": {
      "type": "enumeration",
      "enum": ["month", "list"],
      "default": "month"
    },
    "show_view_toggle": {
      "type": "boolean",
      "default": true
    },
    "empty_state_text": {
      "type": "string",
      "maxLength": 200,
      "default": "Niciun moment programat momentan."
    },
    "background_color": {
      "type": "enumeration",
      "enum": ["paper", "cream"],
      "default": "paper"
    }
  }
}
