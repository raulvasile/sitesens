{
  "collectionName": "components_blocks_featured_campaigns",
  "info": {
    "displayName": "Campanii evidențiate",
    "icon": "rocket",
    "description": "Afișează campaniile active (sau cele marcate evidențiate). Se auto-populează din colecția Campanii."
  },
  "attributes": {
    "anchor_id": {
      "type": "string",
      "maxLength": 60
    },
    "kicker": {
      "type": "string",
      "default": "Campanii",
      "maxLength": 80
    },
    "heading": {
      "type": "string",
      "maxLength": 200
    },
    "mode": {
      "type": "enumeration",
      "enum": [
        "featured",
        "active",
        "all"
      ],
      "default": "active"
    },
    "limit": {
      "type": "integer",
      "min": 1,
      "max": 12,
      "default": 3
    },
    "cta_text": {
      "type": "string",
      "maxLength": 80
    },
    "cta_link": {
      "type": "string",
      "maxLength": 200
    },
    "background_color": {
      "type": "enumeration",
      "enum": [
        "paper",
        "cream"
      ],
      "default": "paper"
    }
  }
}
