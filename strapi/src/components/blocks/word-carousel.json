{
  "collectionName": "components_blocks_word_carousels",
  "info": {
    "displayName": "Carusel cuvinte",
    "icon": "arrowRight",
    "description": "Carusel orizontal cu cuvinte mari care se rotesc (efect ticker)."
  },
  "attributes": {
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.word-carousel-item",
      "min": 2
    },
    "speed_seconds": {
      "type": "integer",
      "default": 30,
      "min": 10,
      "max": 120
    },
    "background_color": {
      "type": "enumeration",
      "enum": [
        "green",
        "dark",
        "white",
        "lime"
      ],
      "default": "green"
    },
    "separator": {
      "type": "string",
      "default": "•",
      "maxLength": 4
    }
  }
}
