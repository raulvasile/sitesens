{
  "collectionName": "components_blocks_file_lists",
  "info": {
    "displayName": "Listă fișiere",
    "icon": "folder",
    "description": "Listă de fișiere descărcabile (PDF, doc, xls). Fiecare fișier apare ca un card cu iconiță potrivită tipului, dimensiune și buton de descărcare."
  },
  "attributes": {
    "anchor_id": {
      "type": "string",
      "maxLength": 60
    },
    "kicker": {
      "type": "string",
      "maxLength": 80
    },
    "heading": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "subheading": {
      "type": "text",
      "maxLength": 400
    },
    "files": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.file-item"
    },
    "background_color": {
      "type": "enumeration",
      "enum": ["paper", "cream"],
      "default": "paper"
    }
  }
}
