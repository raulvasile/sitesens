{
  "collectionName": "components_blocks_chapter_feeds",
  "info": {
    "displayName": "Feed local filială",
    "icon": "bell",
    "description": "Știri și/sau evenimente filtrate automat pe județul filialei curente."
  },
  "attributes": {
    "anchor_id": {
      "type": "string",
      "maxLength": 60
    },
    "kicker": {
      "type": "string",
      "maxLength": 80
    },
    "heading": {
      "type": "string",
      "maxLength": 200
    },
    "show": {
      "type": "enumeration",
      "enum": [
        "articles",
        "events",
        "both"
      ],
      "default": "both"
    },
    "limit": {
      "type": "integer",
      "min": 1,
      "max": 12,
      "default": 3
    },
    "background_color": {
      "type": "enumeration",
      "enum": [
        "paper",
        "cream"
      ],
      "default": "cream"
    }
  }
}
