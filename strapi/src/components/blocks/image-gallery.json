{
  "collectionName": "components_blocks_image_galleries",
  "info": {
    "displayName": "Galerie de imagini",
    "icon": "picture",
    "description": "Galerie cu mai multe imagini."
  },
  "attributes": {
    "anchor_id": {
      "type": "string",
      "maxLength": 60
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "layout": {
      "type": "enumeration",
      "enum": [
        "grid",
        "carousel"
      ],
      "default": "grid"
    },
    "caption": {
      "type": "string"
    }
  }
}
