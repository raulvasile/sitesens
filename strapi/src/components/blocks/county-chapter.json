{
  "collectionName": "components_blocks_county_chapters",
  "info": {
    "displayName": "Filială pe județ",
    "icon": "pin",
    "description": "Filiala asociată unui județ. Folosită în Hartă România pentru navigare. Codul trebuie să corespundă codului ISO 3166-2:RO al județului (ex: CJ, TM, B, IS)."
  },
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "maxLength": 4,
      "regex": "^[A-Z]{1,3}$"
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "url": {
      "type": "string",
      "required": true,
      "maxLength": 300
    },
    "open_in_new_tab": {
      "type": "boolean",
      "default": true
    }
  }
}
