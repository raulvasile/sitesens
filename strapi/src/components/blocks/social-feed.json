{
  "collectionName": "components_blocks_social_feeds",
  "info": {
    "displayName": "Social Feed",
    "icon": "globe",
    "description": "Secțiune urmărește-ne cu link-uri către rețele sociale"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "default": "Urmărește-ne",
      "maxLength": 150
    },
    "subtitle": {
      "type": "text",
      "maxLength": 400
    },
    "platforms": {
      "type": "component",
      "repeatable": true,
      "component": "social.platform"
    },
    "show_embeds": {
      "type": "boolean",
      "default": false
    },
    "posts_heading": {
      "type": "string",
      "default": "Ultimele postări",
      "maxLength": 120
    },
    "embed_fallback_text": {
      "type": "string",
      "default": "Deschide pe {platform}",
      "maxLength": 100
    },
    "variant": {
      "type": "enumeration",
      "enum": ["full", "compact"],
      "default": "full"
    },
    "facebook_url": {
      "type": "string",
      "private": true
    },
    "instagram_url": {
      "type": "string",
      "private": true
    },
    "show_facebook": {
      "type": "boolean",
      "private": true
    },
    "show_instagram": {
      "type": "boolean",
      "private": true
    }
  }
}
