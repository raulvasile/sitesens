{
  "collectionName": "components_blocks_social_feeds",
  "info": {
    "displayName": "Feed Social",
    "icon": "globe",
    "description": "Feed cu postări sau linkuri din social media."
  },
  "options": {},
  "attributes": {
    "anchor_id": {
      "type": "string",
      "maxLength": 60
    },
    "title": {
      "type": "string",
      "default": "Urmărește-ne",
      "maxLength": 150
    },
    "subtitle": {
      "type": "text",
      "maxLength": 400
    },
    "platforms": {
      "type": "component",
      "repeatable": true,
      "component": "social.platform"
    },
    "show_embeds": {
      "type": "boolean",
      "default": false
    },
    "posts_heading": {
      "type": "string",
      "default": "Ultimele postări",
      "maxLength": 120
    },
    "embed_fallback_text": {
      "type": "string",
      "default": "Deschide pe {platform}",
      "maxLength": 100
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "full",
        "compact"
      ],
      "default": "full"
    }
  }
}
