{
  "collectionName": "components_event_social_posts",
  "info": {
    "displayName": "Postare social (Eveniment)",
    "icon": "message",
    "description": "Link către o postare social media legată de un eveniment trecut (Facebook, Instagram etc.). Apare ca un card cu link în pagina evenimentului."
  },
  "attributes": {
    "platform": {
      "type": "enumeration",
      "enum": [
        "facebook",
        "instagram",
        "twitter",
        "tiktok",
        "youtube",
        "linkedin"
      ],
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "maxLength": 500
    }
  }
}
