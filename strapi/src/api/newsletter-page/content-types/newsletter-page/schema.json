{
  "kind": "singleType",
  "collectionName": "newsletter_pages",
  "info": {
    "singularName": "newsletter-page",
    "pluralName": "newsletter-pages",
    "displayName": "Pagină Newsletter",
    "description": "Conținutul paginii /newsletter (text introductiv, formular)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "Rămâi la curent cu SENS",
      "maxLength": 150
    },
    "description": {
      "type": "text",
      "default": "Abonează-te la newsletter pentru știri, comunicate și actualizări din partid. Primești maxim 2 emailuri pe săptămână.",
      "maxLength": 500
    },
    "form": {
      "type": "component",
      "repeatable": false,
      "component": "form.newsletter-form"
    },
    "benefits_heading": {
      "type": "string",
      "default": "Ce vei primi",
      "maxLength": 100
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "social.feature"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
