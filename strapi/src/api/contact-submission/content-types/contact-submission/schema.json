{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Mesaje Contact",
    "description": "Mesaje primite din blocul Formular Contact. Read-only din admin (înregistrate prin POST)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 150,
      "minLength": 1,
      "private": true
    },
    "email": {
      "type": "email",
      "required": true,
      "maxLength": 254,
      "private": true
    },
    "subject": {
      "type": "string",
      "maxLength": 200,
      "private": true
    },
    "message": {
      "type": "text",
      "required": true,
      "maxLength": 3000,
      "private": true
    },
    "consent_gdpr": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "read",
        "answered"
      ],
      "default": "new",
      "required": true
    }
  }
}
