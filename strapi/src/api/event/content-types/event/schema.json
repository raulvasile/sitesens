{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Evenimente",
    "description": "Dezbateri, acțiuni, marșuri și întâlniri online ale partidului. Afișate la /evenimente."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "blocks"
    },
    "start_date": {
      "type": "datetime",
      "required": true
    },
    "end_date": {
      "type": "datetime"
    },
    "location_name": {
      "type": "string"
    },
    "venue": {
      "type": "string",
      "maxLength": 200
    },
    "city": {
      "type": "string",
      "maxLength": 120
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "max_participants": {
      "type": "integer"
    },
    "spots_taken": {
      "type": "integer",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "registration_url": {
      "type": "string",
      "maxLength": 500
    },
    "registration_open": {
      "type": "boolean",
      "default": true
    },
    "event_type": {
      "type": "enumeration",
      "enum": [
        "dezbatere",
        "actiune",
        "mars",
        "online"
      ],
      "required": true
    },
    "social_posts_description": {
      "type": "text",
      "maxLength": 500
    },
    "social_posts": {
      "type": "component",
      "repeatable": true,
      "component": "event.social-post"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
