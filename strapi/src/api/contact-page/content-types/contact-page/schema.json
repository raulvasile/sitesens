{
  "kind": "singleType",
  "collectionName": "contact_pages",
  "info": {
    "singularName": "contact-page",
    "pluralName": "contact-pages",
    "displayName": "Pagină Contact",
    "description": "Conținutul paginii /contact: date de contact, formular și newsletter."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "Contact"
    },
    "subtitle": {
      "type": "text"
    },
    "email": {
      "type": "email",
      "default": "contact@cusens.eu"
    },
    "address": {
      "type": "text"
    },
    "schedule": {
      "type": "string"
    },
    "newsletter_title": {
      "type": "string"
    },
    "newsletter_description": {
      "type": "text"
    },
    "header_eyebrow": {
      "type": "string",
      "maxLength": 80
    },
    "form_kicker": {
      "type": "string",
      "default": "Mesaj direct",
      "maxLength": 80
    },
    "form_title": {
      "type": "string",
      "default": "Trimite-ne un mesaj",
      "maxLength": 120
    },
    "info_heading": {
      "type": "string",
      "default": "Date de contact",
      "maxLength": 120
    },
    "social_heading": {
      "type": "string",
      "default": "Urmărește-ne",
      "maxLength": 80
    },
    "form": {
      "type": "component",
      "repeatable": false,
      "component": "form.contact-form-config"
    },
    "validation": {
      "type": "component",
      "repeatable": false,
      "component": "form.validation-messages"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
