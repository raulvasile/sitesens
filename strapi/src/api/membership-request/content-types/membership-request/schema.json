{
  "kind": "collectionType",
  "collectionName": "membership_requests",
  "info": {
    "singularName": "membership-request",
    "pluralName": "membership-requests",
    "displayName": "Cereri de Aderare",
    "description": "Cereri primite din formularul /inscrie-te. Read-only din admin (înregistrate prin POST)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "first_name": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "minLength": 1,
      "private": true
    },
    "last_name": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "minLength": 1,
      "private": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true,
      "maxLength": 254,
      "private": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 20,
      "regex": "^(\\+?4)?0[0-9]{9}$",
      "private": true
    },
    "birth_date": {
      "type": "date",
      "required": true,
      "private": true
    },
    "county": {
      "type": "string",
      "required": true,
      "maxLength": 50,
      "private": true
    },
    "city": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "private": true
    },
    "address": {
      "type": "text",
      "required": true,
      "maxLength": 500,
      "private": true
    },
    "motivation": {
      "type": "text",
      "maxLength": 1000,
      "private": true
    },
    "interests": {
      "type": "json",
      "private": true
    },
    "consent_gdpr": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "consent_statute": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "consent_data_processing": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "consent_newsletter": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "required": true
    },
    "notes": {
      "type": "text",
      "private": true,
      "maxLength": 2000
    }
  }
}
