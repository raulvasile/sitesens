# ─── Server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# ─── Strapi secrets — generate each with: openssl rand -base64 32 ──
# WARNING: APP_KEYS must be 4 comma-separated values. Changing them
# invalidates all admin sessions. NEVER change ENCRYPTION_KEY or
# API_TOKEN_SALT after first boot — invalidates encrypted data and tokens.
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Used by admin.ts to sign preview URLs from CMS → frontend.
# MUST match the frontend's VITE_PREVIEW_SECRET (built into the client bundle).
PREVIEW_SECRET=

# ─── Database ───────────────────────────────────────────
# Use either DATABASE_URL (single connection string) or the discrete vars.
# Railway / managed Postgres typically provide DATABASE_URL.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_SSL=false
# Discrete vars (alternative to DATABASE_URL):
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=

# ─── Reverse-proxy awareness ───────────────────────────
# When Strapi runs behind Cloudflare / Caddy / nginx, set these so admin-
# generated absolute URLs (uploads, preview redirects) match the public origin
# instead of falling back to http://localhost:1337.
PUBLIC_URL=https://cms.cusens.eu
IS_PROXIED=true

# ─── CORS ──────────────────────────────────────────────
# Comma-separated list of origins allowed to call /api. FAIL-CLOSED în producție:
# dacă lipsește când NODE_ENV=production, se folosește https://cusens.eu (NU "*").
# În dev, dacă lipsește, rămâne "*".
CORS_ORIGIN=https://cusens.eu

# ─── Read-only API token (închiderea citirilor publice) ─
# ACELAȘI token read-only pe care-l pui în frontend (STRAPI_API_TOKEN). Trebuie
# să existe și AICI, în env-ul Strapi: seed-ul `setupPublicPermissions` revocă
# permisiunile publice `find`/`findOne` DOAR când îl detectează. Fără el, citirile
# publice rămân deschise (PII e protejat oricum prin flag-uri `private` + PII
# lockdown din seed, dar restul conținutului rămâne citibil anonim).
# Generează-l în admin: Settings → API Tokens → type: Read-only.
STRAPI_API_TOKEN=

# ─── Retenție date (GDPR minimizare) ───────────────────
# Job cron (config/cron.ts) care șterge zilnic date „moarte": semnături petiție
# neverificate + abonați newsletter pending mai vechi de N zile, cereri de aderare
# respinse mai vechi de M zile. DEZACTIVAT by default — pornește cu true.
RETENTION_ENABLED=false
RETENTION_UNVERIFIED_DAYS=30
RETENTION_REJECTED_DAYS=180
# CRON_ENABLED=true  # (default true; setează false ca să oprești tot cron-ul)

# ─── Frontend integration ──────────────────────────────
# Used by admin preview redirects + bootstrap migrations.
CLIENT_URL=https://cusens.eu
FRONTEND_URL=https://cusens.eu

# ─── Cloudflare cache invalidation ────────────────────
# Strapi lifecycle hooks (src/api/*/lifecycles.ts) call the Cloudflare Purge
# API after every CRUD on user-facing content. Skipped silently in dev when
# either var is missing — no risk of accidental purge from local.
#
# Token: Cloudflare → My Profile → API Tokens → Custom Token
#   Permissions: Zone : Cache Purge : Purge
#   Zone Resources: Specific zone → cusens.eu
CF_ZONE_ID=
CF_API_TOKEN=
PUBLIC_SITE_URL=https://cusens.eu
