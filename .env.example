# ──────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill the blanks before deploying.
#
# To generate a strong secret on macOS / Linux:
#   openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────

# ─── Domain ──────────────────────────────────────────────────────
# Public hostnames (without protocol). DNS A records must point at
# the VPS IP for both, and ports 80/443 must be reachable.
SITE_DOMAIN=cusens.eu
STRAPI_DOMAIN=cms.cusens.eu

# Email used by Caddy when registering with Let's Encrypt.
# You'll receive cert-expiry notifications here.
ACME_EMAIL=admin@cusens.eu

# ─── Database ────────────────────────────────────────────────────
DB_PASSWORD=

# ─── Strapi secrets (REQUIRED) ───────────────────────────────────
# APP_KEYS is a comma-separated list of 4 base64 strings.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Used to sign preview URLs from Strapi admin → frontend.
PREVIEW_SECRET=

# ─── Analytics (optional) ────────────────────────────────────────
VITE_GTM_ID=
