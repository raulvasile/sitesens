# VITE_STRAPI_URL — URL PUBLIC al Strapi, folosit în browser DOAR pentru media
# (getStrapiMediaUrl afișează pozele). Se inlinează în bundle-ul de client.
VITE_STRAPI_URL=http://localhost:1337
VITE_SITE_URL=http://localhost:5173

# STRAPI_URL — URL folosit de SERVER pentru citiri (SSR). Opțional; dacă lipsește
# se folosește STRAPI_URL_INTERNAL (Docker) sau, în ultim caz, VITE_STRAPI_URL.
# Îl setezi când vrei ca API-ul de citire să difere de hostul de media.
# STRAPI_URL=http://localhost:1337

# STRAPI_URL_INTERNAL — URL intern pentru rețeaua Docker (ex: http://strapi:1337).
# STRAPI_URL_INTERNAL=

# STRAPI_API_TOKEN — token READ-ONLY generat în Strapi (Settings → API Tokens →
# type: Read-only). SERVER-ONLY. Când e setat, SSR-ul citește autentificat și
# permisiunile publice de read din Strapi se pot închide (vezi SSR hardening în
# docs/roadmap-implementare.md). Lasă gol în dev pentru citiri publice.
STRAPI_API_TOKEN=

# Secretul de preview (draft) — SERVER-ONLY, nu folosi prefixul VITE_ (s-ar
# inlina în bundle-ul de client). Trebuie să fie identic cu PREVIEW_SECRET din
# strapi/.env. (VITE_PREVIEW_SECRET mai e acceptat ca fallback pentru compat.)
PREVIEW_SECRET=
